	["Common.UGCValidation.ErrorLabel.AQSWarn_MissingData"] = "Die Validierungsdaten f\195\188r {measureName} konnten nicht berechnet werden, da die Eingabedaten unvollst\195\164ndig oder ung\195\188ltig waren. Dies blockiert deinen Upload nicht.",
