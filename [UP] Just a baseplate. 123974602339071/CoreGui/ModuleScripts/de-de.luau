	["Common.UGCValidation.ErrorLabel.CurveAnim_FetchFailed"] = "Die CurveAnimation-Daten konnten nicht geladen werden. M\195\182glicherweise ist das Animationsobjekt ung\195\188ltig oder nicht zug\195\164nglich.",
