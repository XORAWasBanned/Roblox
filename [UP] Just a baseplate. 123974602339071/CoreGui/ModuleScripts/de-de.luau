	["Common.UGCValidation.ErrorLabel.CurveAnim_StrictSchemaViolation"] = "Die CurveAnimation-Struktur ist ung\195\188ltig: {detail}. Bitte vergewissere dich, dass die Animation dem erwarteten Schema entspricht.",
