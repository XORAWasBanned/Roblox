	["Common.UGCValidation.ErrorLabel.CurveAnim_NotCurveAnimation"] = "Die referenzierte Animation ist keine CurveAnimation. Bitte vergewissere dich, dass die Animation korrekt hochgeladen wurde.",
	["Common.UGCValidation.ErrorLabel.CurveAnim_PartTooFar"] = "In der CurveAnimation befindet sich das K\195\182rperteil {bodyPart} zum Zeitpunkt {time}\194\160Sekunden {distance}\194\160Noppen vom HumanoidRootPart entfernt. K\195\182rperteile d\195\188rfen nicht mehr als {maxDistance}\194\160Noppen vom HumanoidRootPart entfernt sein. Bitte korrigiere die Animation.",
	["Common.UGCValidation.ErrorLabel.CurveAnim_PartTooLow"] = "In der CurveAnimation befindet sich das K\195\182rperteil {bodyPart} zum Zeitpunkt {time} Sekunden in einer H\195\182he von {height}\194\160Noppen vom HumanoidRootPart entfernt. K\195\182rperteile d\195\188rfen nicht tiefer als {minHeight}\194\160Noppen vom HumanoidRootPart entfernt sein. Bitte korrigiere die Animation.",
	["Common.UGCValidation.ErrorLabel.CurveAnim_PositionSeparation"] = "CurveAnimation enth\195\164lt eine positionelle Trennung von K\195\182rperteilen. Nur der LowerTorso kann seine Position \195\164ndern. Alle anderen K\195\182rperteile k\195\182nnen nur ihre Ausrichtung \195\164ndern. {bodyPart} bewegt sich um mehr als {maxMovement}\194\160Noppen von seinem \195\188bergeordneten K\195\182rperteil entfernt. Bitte korrigiere die Animation.",
	["Common.UGCValidation.ErrorLabel.CurveAnim_RotationTooFast"] = "In der CurveAnimation bewegt sich das K\195\182rperteil {bodyPart} zum Zeitpunkt {time}\194\160Sekunden mit einer Rotationsgeschwindigkeit von {speed}\194\160Grad/Sekunde. Es sind maximal {maxSpeed}\194\160Grad/Sekunde erlaubt. Bitte korrigiere die Animation.",
	["Common.UGCValidation.ErrorLabel.CurveAnim_SpeedTooFast"] = "In der CurveAnimation bewegt sich das K\195\182rperteil {bodyPart} zum Zeitpunkt {time}\194\160Sekunden mit einer Geschwindigkeit von {speed}\194\160Noppen/Sekunde. Es sind maximal {maxSpeed} Noppen/Sekunde erlaubt. Bitte korrigiere die Animation.",
