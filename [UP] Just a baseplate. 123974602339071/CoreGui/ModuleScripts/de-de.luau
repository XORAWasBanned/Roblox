	["Common.UGCValidation.ErrorLabel.AQSWarn_JointNumber"] = "Unerwartete Gelenkkonfiguration. Gelenke insgesamt: {joint_number}, Gelenke in der linken Hand: {left_hand_joint_number}, Gelenke in der rechten Hand: {right_hand_joint_number}.",
	["Common.UGCValidation.ErrorLabel.AQSWarn_MeshIslandVolume"] = "{partName} enth\195\164lt {num_small_volume_islands} kleine, nicht verbundene Mesh-Inseln von insgesamt {num_disconnected_components}\194\160Komponenten. Bitte entferne die schwebende Geometrie.",
	["Common.UGCValidation.ErrorLabel.AQSWarn_MeshManifold"] = "{partName} hat eine nicht-mannigfaltige Geometrie. Bitte \195\188berpr\195\188fe, ob nicht-ebene Fl\195\164chen, sich selbst schneidende Fl\195\164chen oder Kanten vorhanden sind, die von mehr als zwei Fl\195\164chen gemeinsam genutzt werden.",
