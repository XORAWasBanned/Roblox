	["Common.UGCValidation.ErrorLabel.MeasureCageMeshDistance_CageInsideMesh"] = "Der \195\164u\195\159ere Cage \195\188berschneidet sich mit dem Render-Mesh. {negtiveSDFPercent}\194\160% der Eckpunkte des \195\164u\195\159eren Cages liegen innerhalb des Render-Mesh.",
