	["Common.UGCValidation.ErrorLabel.DescendantIdVersionNotSupported"] = "{InstanceFullName}.{FieldName} verwendet Version {Version} des Objekts {AssetId}, aber derzeit wird nur Version\194\1601 unterst\195\188tzt. Verwende Version\194\1601 und versuche es erneut.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadCageMisaligned"] = "Dynamische K\195\182pfe auf dem Marktplatz m\195\188ssen ordnungsgem\195\164\195\159 gecaged sein, damit die Augen- und Mundscheitelpunkte auf dem Cage mit den Mesh-Scheitelpunkten \195\188bereinstimmen. Bitte verbessere deine Cages und deren Ausrichtung mit dem Netz.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadCageMisalignedLeftEye"] = "Die Orientierungspunkte f\195\188r das linken Auges des dynamischen Kopf-Cages sind nicht korrekt mit dem Mesh ausgerichtet. Passe den Augen-Cage so an, dass sich das Mesh des linken Auges innerhalb des projizierten Cage-Bereichs befindet.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadCageMisalignedMouth"] = "Die Orientierungspunkte f\195\188r den Mund des dynamischen Kopf-Cages sind nicht korrekt mit dem Mesh ausgerichtet. Passe den Mund-Cage so an, dass sich das Mund-Mesh innerhalb des projizierten Cage-Bereichs befindet.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadCageMisalignedRightEye"] = "Die Orientierungspunkte f\195\188r das rechte Auge des dynamischen Kopf-Cages sind nicht korrekt mit dem Mesh ausgerichtet. Passe den Augen-Cage so an, dass sich das Mesh des rechten Auges innerhalb des projizierten Cage-Bereichs befindet.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadHappyNotShown"] = "Der Ausdruck \"L\195\164cheln\" f\195\188r den dynamischen Kopf kann nicht erkannt werden. Bitte passe die Cage-Orientierungspunkte f\195\188r den Mund so an, dass sie mit der Position des Mundes auf dem Kopf \195\188bereinstimmen, und stelle sicher, dass er den Ausdruck \"L\195\164cheln\" zeigen kann.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadLeftEyeNotClose"] = "Der Ausdruck \"Linkes Auge geschlossen\" kann f\195\188r den dynamischen Kopf nicht erkannt werden. Bitte passe die Cage-Orientierungspunkte f\195\188r das linke Auge so an, dass sie mit der Position des linken Auges auf dem Kopf \195\188bereinstimmen, und stelle sicher, dass es geschlossen werden kann.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadMISSINGCAGE"] = "F\195\188r dynamische K\195\182pfe auf dem Marktplatz sind keine Kopf-Cages angegeben. Bitte erstelle einen Kopf-Cage f\195\188r den dynamischen Kopf.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadMouthNotOpen"] = "Der Ausdruck \"Ge\195\182ffneter Mund\" kann f\195\188r den dynamischen Kopf nicht erkannt werden. Bitte passe die Cage-Orientierungspunkte f\195\188r den Mund so an, dass sie mit der Position des Mundes auf dem Kopf \195\188bereinstimmen, und stelle sicher, dass er sich \195\182ffnen kann.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadNOFACS"] = "Dynamische K\195\182pfe auf dem Marktplatz m\195\188ssen animiert sein, aber diesem Kopf fehlen FACS-Daten.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadRightEyeNotClose"] = "Der Ausdruck \"Rechtes Auge geschlossen\" kann f\195\188r den dynamischen Kopf nicht erkannt werden. Bitte passe die Cage-Orientierungspunkte f\195\188r das rechte Auge so an, dass sie mit der Position des rechten Auges auf dem Kopf \195\188bereinstimmen, und stelle sicher, dass es geschlossen werden kann.",
	["Common.UGCValidation.ErrorLabel.DynamicHeadSadNotShown"] = "Der Ausdruck \"Stirnrunzeln\" f\195\188r den dynamischen Kopf kann nicht erkannt werden. Bitte passe die Cage-Orientierungspunkte f\195\188r den Mund so an, dass sie mit der Position des Mundes auf dem Kopf \195\188bereinstimmen, und stelle sicher, dass er den Ausdruck \"Stirnrunzeln\" zeigen kann.",
	["Common.UGCValidation.ErrorLabel.EmissiveArea_AboveThreshold"] = "Emissiver Bereich \195\188ber dem Schwellenwert.",
