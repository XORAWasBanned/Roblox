	["Common.UGCValidation.ErrorLabel.HrdMissingStandardJoint"] = "Die Verbindung {jointName} ist eine Standard-R15-Verbindung, aber die Rig-Befestigung ist nicht mit HRD verbunden. Stelle sicher, dass HRD unter deinem Avatar mit einem AttachmentConstraint und nicht mit Motor6d verkn\195\188pft ist.",
