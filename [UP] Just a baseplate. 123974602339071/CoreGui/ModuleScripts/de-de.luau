	["Common.UGCValidation.ErrorLabel.AnimationPack_DuplicateAnimationId"] = "Das Animationspaket-Bundle enth\195\164lt eine doppelte Animations-ID \"{animationId}\", die von mehreren Clips verwendet wird: {instancePaths}. Jeder Animationsclip muss auf ein eindeutiges Animationsobjekt verweisen.",
	["Common.UGCValidation.ErrorLabel.AnimationPack_InvalidR15AnimChildren"] = "Im Animationspaket-Bundle fehlen die erwarteten Animationstypen: {missingAnimationTypes}. Jeder Animationstyp muss einen R15Anim-Ordner haben, der genau seine erwarteten StringValue-Unterordner enth\195\164lt.",
	["Common.UGCValidation.ErrorLabel.Animation_WeightNotPositive"] = "Die Animation \"{animationName}\" hat einen Gewichtswert von {weight}, aber das Gewicht muss gr\195\182\195\159er als 0 sein. Bitte korrigiere die Animation.",
