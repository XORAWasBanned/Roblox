	["Common.UGCValidation.ErrorLabel.CurveAnim_JointRotationExceeded"] = "In der CurveAnimation hat das Gelenk {bodyPart} zum Zeitpunkt {time}\194\160Sekunden einen Rotationswinkel von {rotation}\194\160Grad von der Ruheposition. Der maximal zul\195\164ssige Wert betr\195\164gt {maxRotation}\194\160Grad. Bitte korrigiere die Animation.",
