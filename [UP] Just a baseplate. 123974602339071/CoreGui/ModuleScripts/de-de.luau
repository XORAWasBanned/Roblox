	["Common.UGCValidation.ErrorLabel.FacsDeformation_SadNotShown"] = "Der traurige Gesichtsausdruck kann nicht erkannt werden. Passe den Cage des Mundes oder das FACS f\195\188r den traurigen Gesichtsausdruck an, damit sich das projizierte Mund-Mesh wie erwartet verformt.",
	["Common.UGCValidation.ErrorLabel.FacsExpandsHead"] = "Wir haben festgestellt, dass FACS deinen Kopf auf {modPercent}\194\160% vergr\195\182\195\159ert hat. Die \195\132nderung des Kopfes verst\195\182\195\159t jedoch gegen die Marktplatzrichtlinien f\195\188r Gesichtsanimationen.",
	["Common.UGCValidation.ErrorLabel.FacsJointCountBounded"] = "Dynamische K\195\182pfe d\195\188rfen h\195\182chstens {maxFacsJointCount}\194\160FACS-Gelenke haben, aber dieser Kopf hat {actualJointCount}. Bitte reduziere die Anzahl der FACS-Gelenke und versuche es erneut.",
	["Common.UGCValidation.ErrorLabel.FacsShrinksHead"] = "Wir haben festgestellt, dass FACS deinen Kopf auf {modPercent}\194\160% verkleinert hat. Die \195\132nderung des Kopfes verst\195\182\195\159t jedoch gegen die Marktplatzrichtlinien f\195\188r Gesichtsanimationen.",
	["Common.UGCValidation.ErrorLabel.FolderStructureMismatch"] = "Das Upload-Format stimmt nicht mit der erwarteten Ordnerstruktur \195\188berein. Bitte versuche es erneut oder erstelle einen Fehlerbericht.",
	["Common.UGCValidation.ErrorLabel.HrdBone_OutOfBounds"] = "Der Knochen {bonePath} liegt zu weit au\195\159erhalb des Mesh-Teils {partName}. Bitte platziere ihn n\195\164her an der Gr\195\182\195\159enbegrenzung des Mesh-Teils.",
	["Common.UGCValidation.ErrorLabel.HrdBone_TooCloseToParent"] = "Der Knochen {bonePath} liegt zu nahe an seinem \195\188bergeordneten Knochen. Passe die Position des Knochens leicht an.",
	["Common.UGCValidation.ErrorLabel.HrdBone_TransformNotIdentity"] = "Der Knochen {bonePath} hat eine Transform-Eigenschaft, die jedoch noch nicht f\195\188r Marktplatz-Uploads aktiviert ist. Bitte setze sie auf den Identit\195\164ts-CFrame zur\195\188ck.",
	["Common.UGCValidation.ErrorLabel.HrdCheck_BoneNotMappedInHRD"] = "Der Knochen {boneName} ist zul\195\164ssig, du musst ihn aber explizit in der HumanoidRigDescription oder der DigitRigDescription zuordnen.",
