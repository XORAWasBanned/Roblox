	["Common.UGCValidation.ErrorLabel.HrdProperties_UncontainedJoint"] = "Auf die HRD-Eigenschaft {jointName} wird von der Instanz innerhalb von {foundMeshName} verwiesen, sie ist jedoch nicht Teil der enthaltenen Liste. Wenn du aus Studio ver\195\182ffentlichst und nur \195\188ber die HRD/DRD auf Avatarebene verf\195\188gst, erstelle bitte einen Fehlerbericht.",
