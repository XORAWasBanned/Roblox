	["CreatorDashboard.Analytics.Overview.Improve.D1Retention"] = "\226\128\162 Sorge daf\195\188r, dass es Spa\195\159 macht, deine Hauptaktivit\195\164t immer wieder zu spielen\n\226\128\162 Belohne t\195\164glich aktive Spieler\n\226\128\162 Speichere den Fortschritt der Spieler",
