	["Common.UGCValidation.ErrorLabel.CurveAnim_BodyPartHasPosition"] = "Das K\195\182rperteil \"{bodyPartName}\" in CurveAnimation hat eine Positionsspur (\195\156bersetzung). K\195\182rperteile in Animationen d\195\188rfen nur rotiert werden. Positionspuren sind nicht erlaubt. Bitte entferne die Positionsspur von diesem K\195\182rperteil.",
	["Common.UGCValidation.ErrorLabel.CurveAnim_BodyPartTranslationExceedsThreshold"] = "Der K\195\182rperteil \"{bodyPartName}\" in CurveAnimation bewegt sich um {distance}\194\160Noppen von seiner Startposition. Die maximal zul\195\164ssige Verschiebung betr\195\164gt {maxDistance}\194\160Noppen. Bitte reduziere die Positionsbewegung des K\195\182rperteils.",
	["Common.UGCValidation.ErrorLabel.CurveAnim_BodyPartWithBoneHasPosition"] = "CurveAnimation enth\195\164lt HRD/DRD-Knochen und das K\195\182rperteil \"{bodyPartName}\" hat eine Positionsspur (\195\156bersetzung). Wenn in der Animation Knochen vorhanden sind, d\195\188rfen keine K\195\182rperteile verschoben werden, um eine Trennung der Verbindungen zu verhindern. Bitte entferne alle Positionsspuren von K\195\182rperteilen.",
